// ═══════════════════════════════════════════════════════════
// API: AE Analytics Dashboard
// Aggregates KPIs for Account Executive: clients, contracts, revenue
// ═══════════════════════════════════════════════════════════

import { NextResponse } from "next/server";
import { createClient } from "@/lib/supabase/server";

export const dynamic = "force-dynamic";

// eslint-disable-next-line @typescript-eslint/no-explicit-any
type Any = any;

export async function GET() {
  try {
    const supabase = createClient();

    // Get current user
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) {
      return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
    }

    const { data: profile } = await supabase
      .from("profiles")
      .select("id, role, division")
      .eq("id", user.id)
      .single();

    if (!profile) {
      return NextResponse.json({ error: "Profile not found" }, { status: 404 });
    }

    // Check if user is AE or admin
    const isAE = profile.division === "account_executive" || profile.role === "account_executive";
    const isAdmin = profile.role === "admin" || profile.role === "super_admin";

    // If not AE, filter by assigned_to; admins see all
    const clientFilter = (!isAE && !isAdmin) ? null : (isAE ? profile.id : null);

    const now = new Date();
    const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
    const in30Days = new Date(now.getTime() + 30 * 24 * 60 * 60 * 1000);

    // ── 1. Total Clients ──
    let clientsQuery = supabase.from("clients").select("id, assigned_to", { count: "exact", head: true });
    if (clientFilter) clientsQuery = clientsQuery.eq("assigned_to", clientFilter);
    const { count: totalClients } = await clientsQuery;

    // ── 2. Active Contracts ──
    let contractsQuery = supabase
      .from("client_contracts")
      .select("id, monthly_value, end_date, client:clients!inner(assigned_to)", { count: "exact", head: true })
      .eq("status", "active");
    if (clientFilter) contractsQuery = contractsQuery.eq("client.assigned_to", clientFilter);
    const { count: activeContracts } = await contractsQuery;

    // ── 3. Monthly Recurring Revenue ──
    let mrrQuery = supabase
      .from("client_contracts")
      .select("monthly_value, client:clients!inner(assigned_to)")
      .eq("status", "active");
    if (clientFilter) mrrQuery = mrrQuery.eq("client.assigned_to", clientFilter);
    const { data: mrrData } = await mrrQuery;
    const monthlyRecurring = ((mrrData as Any[]) || []).reduce(
      (sum, c) => sum + (Number(c.monthly_value) || 0),
      0
    );

    // ── 4. Expiring Contracts (within 30 days) ──
    let expiringQuery = supabase
      .from("client_contracts")
      .select("id, client:clients!inner(assigned_to)")
      .eq("status", "active")
      .lte("end_date", in30Days.toISOString())
      .gte("end_date", now.toISOString());
    if (clientFilter) expiringQuery = expiringQuery.eq("client.assigned_to", clientFilter);
    const { count: expiringContracts } = await expiringQuery;

    // ── 5. Pending Invoices & Overdue Amount ──
    let invQuery = supabase
      .from("invoices")
      .select("id, amount, due_date, status, client:clients!inner(assigned_to)")
      .in("status", ["sent", "overdue"]);
    if (clientFilter) invQuery = invQuery.eq("client.assigned_to", clientFilter);
    const { data: invoices } = await invQuery;

    const pendingInvoices = (invoices as Any[])?.length || 0;
    const overdueAmount = ((invoices as Any[]) || [])
      .filter((inv) => new Date(inv.due_date) < now && inv.status !== "paid")
      .reduce((sum, inv) => sum + (Number(inv.amount) || 0), 0);

    // ── 6. Collected This Month ──
    let paidQuery = supabase
      .from("invoices")
      .select("amount, paid_at, client:clients!inner(assigned_to)")
      .eq("status", "paid")
      .gte("paid_at", startOfMonth.toISOString());
    if (clientFilter) paidQuery = paidQuery.eq("client.assigned_to", clientFilter);
    const { data: paidInvoices } = await paidQuery;
    const collectedThisMonth = ((paidInvoices as Any[]) || []).reduce(
      (sum, inv) => sum + (Number(inv.amount) || 0),
      0
    );

    // ── 7. Upcoming Meetings (calendar events) ──
    const { count: upcomingMeetings } = await supabase
      .from("calendar_events")
      .select("id", { count: "exact", head: true })
      .gte("start_date", now.toISOString())
      .eq("type", "meeting");

    return NextResponse.json({
      totalClients: totalClients || 0,
      activeContracts: activeContracts || 0,
      expiringContracts: expiringContracts || 0,
      monthlyRecurring,
      pendingInvoices,
      overdueAmount,
      collectedThisMonth,
      upcomingMeetings: upcomingMeetings || 0,
    });
  } catch (err) {
    const msg = err instanceof Error ? err.message : "Unknown error";
    return NextResponse.json({ error: msg }, { status: 500 });
  }
}