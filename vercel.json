{
  "crons": [
    {
      "path": "/api/meta/sync",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/reports/cron/send-emails",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/reports/cron/sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/digest?type=daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/digest?type=weekly",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/cron/auto-billing",
      "schedule": "0 0 1 * *"
    }
  ],
  "functions": {
    "src/app/api/reports/sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/reports/cron/sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/reports/import-sheet/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/meta/sync/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/invoices/[id]/pdf/route.ts": {
      "maxDuration": 30
    }
  }
}
