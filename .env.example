# ============================================
# HADONA WORKSPACE - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=https://workspace.hadona.id
NEXT_PUBLIC_SITE_URL=https://workspace.hadona.id
NEXT_PUBLIC_WORKADVENTURE_URL=https://play.workadventure.land

# --- Google OAuth (Calendar & Meet integration) ---
# Gunakan OAuth client "integrasi" (redirect: /api/google/callback) — BUKAN client login.
# Client "login" (Supabase) tidak perlu di sini; daftarkan Client ID/Secret-nya
# di Supabase Dashboard -> Authentication -> Providers -> Google.
# Lihat runbook: MIGRATE-GOOGLE-CLOUD.md
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://workspace.hadona.id/api/google/callback

# --- Meta Marketing API (Facebook Ads) ---
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-facebook-app-secret
META_BUSINESS_ID=your-meta-business-id

# --- Resend (Email API for notifications & reports) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Hadona Workspace <noreply@hadona.id>

# --- Google Sheets (Weekly report import) ---
WEEKLY_REPORT_SHEET_URL=https://docs.google.com/spreadsheets/d/your-sheet-id/edit

# --- Vercel Cron Secret ---
CRON_SECRET=your-random-secret-string-for-cron-auth

# --- Cloudflare R2 (File uploads: invoices, attachments) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=hadona-workspace
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Web Push (VAPID) — generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push relay secret (DB trigger → /api/push/relay) — generate: openssl rand -hex 24
# Harus sama dengan yang disimpan di tabel push_config (diisi scripts/run-migration-v104.mjs)
PUSH_RELAY_SECRET=
