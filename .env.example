# ============================================
# HADONA WORKSPACE - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App ---
NEXT_PUBLIC_APP_URL=https://workspace.hadona.id
NEXT_PUBLIC_WORKADVENTURE_URL=https://play.workadventure.land

# --- Meta Marketing API (Facebook Ads) ---
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-facebook-app-secret

# --- Resend (Email API for notifications & reports) ---
RESEND_API_KEY=re_xxxxxxxxxxxx

# --- Vercel Cron Secret ---
CRON_SECRET=your-random-secret-string-for-cron-auth

# ============================================
# NOTE: File uploads use Supabase Storage (no R2 needed).
# If you need to re-enable Cloudflare R2, see commit 30b15ff
# and add the R2_ variables from git history.
# ============================================